# ── LLM endpoint ──────────────────────────────────────────────────────────────
# Point this at your self-hosted vLLM instance
# Example: http://192.168.1.50:8000/v1
VLLM_BASE_URL=http://host.docker.internal:8000/v1

# API key if your vLLM server has --api-key set; otherwise leave as-is
VLLM_API_KEY=not-required

# ── Repo to scan ───────────────────────────────────────────────────────────────
# Host path to the repo you want to scan.
# It will be mounted read-only at /repos/target inside the container.
# Windows path example: H:\iqa_dev_bck\eyenotes20.auroiqa
SCAN_REPO_PATH=H:\iqa_dev_bck\eyenotes20.auroiqa

# ── GitHub integration (optional) ─────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO_URL=

# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to true if you want to test the pipeline flow without a live LLM
FORCE_MOCK=false
