# AMD Developer Cloud vLLM endpoint (e.g. http://your-instance:8000/v1)
VLLM_BASE_URL=http://localhost:8000/v1

# Optional: API key for vLLM if auth is enabled
VLLM_API_KEY=not-required

# GitHub token for opening real PRs (optional — prints to stdout if absent)
GITHUB_TOKEN=

# Repo URL for PR creation (e.g. https://github.com/user/repo)
GITHUB_REPO_URL=

# Set to "true" to force mock mode regardless of models.yaml
FORCE_MOCK=false
